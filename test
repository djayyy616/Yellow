<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trading Landing Page — Draft</title>

  <style>
    /* =========================
       1. BASIC RESET
       ========================= */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      color: #fff;
      background: radial-gradient(circle at 50% 15%, rgba(255, 220, 0, 0.16), transparent 40%),
radial-gradient(circle at 50% 65%, rgba(255, 220, 0, 0.10), transparent 35%),
#050505;
      line-height: 1.5;
    }

    /* =========================
       2. PAGE BACKGROUND
       ========================= */
   .page {
min-height: 100vh;
overflow: hidden;
background:
radial-gradient(circle at 50% 15%, rgba(255, 220, 0, 0.16), transparent 40%),
radial-gradient(circle at 50% 65%, rgba(255, 220, 0, 0.10), transparent 35%),
#050505;
}

    .container {
      width: min(100% - 40px, 760px);
      margin: 0 auto;
    }

    /* =========================
       3. HEADER / BRAND
       ========================= */
    header {
      padding: 45px 0 20px;
      text-align: center;
    }

    .logo {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 5px;
    }

    .logo span {
      color: #f5c542;
    }

    /* =========================
       4. HERO
       ========================= */
    .hero {
      text-align: center;
      padding: 25px 0 45px;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 18px;
      color: #f5c542;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    h1 {
      max-width: 650px;
      margin: 0 auto 22px;
      font-size: clamp(30px, 7vw, 50px);
      line-height: 1.02;
      letter-spacing: -2px;
      font-weight: 900;
    }

    .yellow {
      color: #FFD700;
    }

    .hero-subtitle {
      max-width: 650px;
      margin: 0 auto;
      color: #fffaf0;
      font-size: clamp(19px, 3vw, 26px);
      font-weight: 800;
    }

    .hero-description {
      max-width: 610px;
      margin: 25px auto 0;
      color: #9a9a9a;
      font-size: 18px;
    }

    /* =========================
       5. VIDEO
       ========================= */
    .video-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;

      border: 1px solid rgba(245, 197, 66, 0.45);
      border-radius: 22px;

      background: #0b0b0b;
      box-shadow:
        0 0 0 1px rgba(245, 197, 66, 0.08),
        0 15px 60px rgba(0, 0, 0, 0.5),
        0 0 35px rgba(245, 197, 66, 0.10);
    }

    .video-placeholder {
      width: 100%;
      height: 100%;
      display: grid;
      place-items: center;
      position: relative;

      background:
        radial-gradient(circle at 50% 40%, rgba(245, 197, 66, 0.12), transparent 40%),
        #0b0b0b;
    }

    .play-button {
      width: 78px;
      height: 78px;
      display: grid;
      place-items: center;

      border: 0;
      border-radius: 50%;
      cursor: pointer;

      color: #050505;
      background: #f5c542;
      box-shadow: 0 0 35px rgba(245, 197, 66, 0.45);
      font-size: 27px;
      padding-left: 5px;
    }

    .video-label {
      position: absolute;
      left: 24px;
      bottom: 20px;
      color: #fff;
      font-weight: 700;
      font-size: 15px;
    }

    /* =========================
       6. DIVIDER
       ========================= */
    .divider {
      width: 105px;
      height: 4px;
      margin: 75px auto 55px;
      border-radius: 99px;
      background: #f5c542;
      box-shadow: 0 0 18px rgba(245, 197, 66, 0.5);
    }

    /* =========================
       7. APPLICATION SECTION
       ========================= */
    .application {
      text-align: center;
      padding-bottom: 80px;
    }

    .application h2 {
      max-width: 680px;
      margin: 0 auto;

      font-size: clamp(31px, 5vw, 48px);
      line-height: 1.08;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .application p {
      margin-top: 15px;
      color: #9a9a9a;
      font-size: 17px;
    }

    .arrow {
      margin: 30px auto;
      color: #f5c542;
      font-size: 50px;
      line-height: 1;
    }

    /* =========================
       8. FORM CARD
       ========================= */
    .form-card {
      margin: 0 auto;
      padding: 42px;
      max-width: 700px;

      text-align: left;
      color: #111;

      background: #fff;
      border-radius: 24px;
      box-shadow:
        0 25px 80px rgba(0, 0, 0, 0.5),
        0 0 30px rgba(245, 197, 66, 0.12);
    }

    .question-number {
      width: 32px;
      height: 32px;
      display: grid;
      place-items: center;

      margin-bottom: 22px;

      border-radius: 7px;
      background: #050505;
      color: #f5c542;
      font-size: 14px;
      font-weight: 800;
    }

    .question {
      margin-bottom: 25px;
      font-size: 25px;
      font-weight: 700;
      line-height: 1.2;
    }

    .required {
      color: #777;
      font-size: 14px;
    }

    .options {
      display: grid;
      gap: 12px;
    }

    .option {
      display: flex;
      align-items: center;
      gap: 12px;

      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 10px;
      cursor: pointer;

      transition: 0.2s ease;
    }

    .option:hover {
      border-color: #f5c542;
      background: #fffaf0;
    }

    .option input {
      width: 18px;
      height: 18px;
      accent-color: #f5c542;
    }

    .next-button {
      width: 100%;
      margin-top: 25px;
      padding: 16px;

      border: 0;
      border-radius: 10px;
      cursor: pointer;

      color: #050505;
      background: #f5c542;
      font-size: 16px;
      font-weight: 800;
      transition: 0.2s ease;
    }

    .next-button:hover {
      background: #ffd75c;
    }

    /* =========================
       9. FOOTER
       ========================= */
    footer {
      padding: 35px 20px;
      text-align: center;
      color: #666;
      font-size: 13px;
    }

    /* =========================
       10. MOBILE
       ========================= */
    @media (max-width: 600px) {
      .container {
        width: min(100% - 28px, 760px);
      }

      header {
        padding-top: 30px;
      }

      .hero {
        padding-top: 18px;
      }

      h1 {
        letter-spacing: -1px;
      }

      .hero-description {
        font-size: 16px;
      }

      .video-wrapper {
        border-radius: 16px;
      }

      .form-card {
        padding: 28px 22px;
        border-radius: 18px;
      }

      .question {
        font-size: 21px;
      }

      .divider {
        margin-top: 55px;
        margin-bottom: 40px;
      }
    }
  </style>
</head>

<body>

