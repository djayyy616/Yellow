  <div class="page">
    <div class="top-line"></div>

    <header>
      <h1>
        Apply To Become Apart of<br>
        The <span class="highlight">Collective</span>
      </h1>
      <p class="subtitle">Answer a few quick questions below.</p>
    </header>

    <div class="arrow" aria-hidden="true">↓</div>

    <main class="form-card">
      <div id="questionnaire">
        <div class="progress-track"
             role="progressbar"
             aria-label="Application progress"
             aria-valuemin="1"
             aria-valuemax="7"
             aria-valuenow="1"
             id="progressTrack">
          <div class="progress-fill" id="progressFill"></div>
        </div>

        <div class="step-count" id="stepCount">QUESTION 1 OF 7</div>
        <div class="step-number" id="stepNumber">1</div>
        <h2 id="questionTitle">Are you already a day trader?</h2>

        <div id="answerArea"></div>

        <p class="error" id="errorMessage" role="alert">
          Please answer this question before continuing.
        </p>

        <div class="buttons">
          <button type="button" class="back" id="backButton" hidden>
            ← Back
          </button>
          <button type="button" class="continue" id="continueButton">
            Continue
          </button>
        </div>
      </div>

      <section id="successScreen" class="success hidden" aria-live="polite">
        <div class="success-mark">✓</div>
        <h2>Application complete!</h2>
        <p>
          Thank you for your interest in ZENTŌ COLLECTIVE.
          Your answers have been recorded in this session.
        </p>
        <p>
          <strong>Important:</strong> your application has not been sent
          to us yet. Submission delivery needs to be connected to a form
          service before this page goes live.
        </p>
      </section>
    </main>

    <footer>© 2026 ZENTŌ COLLECTIVE. All rights reserved.</footer>
  </div>

  <script>
    const questions = [
      {
        title: "Are you already a day trader?",
        type: "radio",
        name: "dayTrader",
        options: ["Yes", "No"]
      },
      {
        title: "How long have you been trading?",
        type: "radio",
        name: "tradingDuration",
        options: [
          "0–6 months",
          "6 months–1 year",
          "1–3 years",
          "3–5 years",
          "5+ years"
        ]
      },
      {
        title: "Why do you want to learn to trade?",
        type: "textarea",
        name: "motivation",
        placeholder: "Tell us why you want to learn to trade..."
      },
      {
        title: "What's your biggest struggle in trading?",
        type: "radio",
        name: "biggestStruggle",
        options: [
          "Trading psychology",
          "Lack of capital",
          "Risk management",
          "Finding my edge in the market",
          "Other"
        ]
      },
      {
        title: "What's your first name?",
        type: "text",
        name: "firstName",
        placeholder: "Enter your first name"
      },
      {
        title: "What's your email address?",
        type: "email",
        name: "email",
        placeholder: "you@example.com"
      },
      {
        title: "What's your phone number?",
        type: "tel",
        name: "phone",
        placeholder: "Enter your phone number"
      }
    ];

    const answers = {};
    let currentStep = 0;

    const answerArea = document.getElementById("answerArea");
    const questionTitle = document.getElementById("questionTitle");
    const stepNumber = document.getElementById("stepNumber");
    const stepCount = document.getElementById("stepCount");
    const progressFill = document.getElementById("progressFill");
    const progressTrack = document.getElementById("progressTrack");
    const errorMessage = document.getElementById("errorMessage");
    const backButton = document.getElementById("backButton");
    const continueButton = document.getElementById("continueButton");

    function renderQuestion() {
      const question = questions[currentStep];

      questionTitle.textContent = question.title;
      stepNumber.textContent = currentStep + 1;
      stepCount.textContent =
        `QUESTION ${currentStep + 1} OF ${questions.length}`;

      const progress = ((currentStep + 1) / questions.length) * 100;
      progressFill.style.width = progress + "%";
      progressTrack.setAttribute("aria-valuenow", currentStep + 1);

      backButton.hidden = currentStep === 0;
      continueButton.textContent =
        currentStep === questions.length - 1
          ? "Complete Application"
          : "Continue";

      errorMessage.classList.remove("visible");
      answerArea.innerHTML = "";

      if (question.type === "radio") {
        const options = document.createElement("div");
        options.className = "options";

        question.options.forEach((option, index) => {
          const label = document.createElement("label");
          label.className = "option";

          const input = document.createElement("input");
          input.type = "radio";
          input.name = question.name;
          input.value = option;
          input.required = true;
          input.checked = answers[question.name] === option;

          input.addEventListener("change", () => {
            answers[question.name] = input.value;
            errorMessage.classList.remove("visible");
          });

          const text = document.createElement("span");
          text.textContent = option;

          label.append(input, text);
          options.appendChild(label);
        });

        answerArea.appendChild(options);
      } else {
        const input = document.createElement(
          question.type === "textarea" ? "textarea" : "input"
        );

        input.className = "text-field";
        input.name = question.name;
        input.required = true;
        input.placeholder = question.placeholder || "";
        input.value = answers[question.name] || "";

        if (question.type !== "textarea") {
          input.type = question.type;
          input.autocomplete =
            question.type === "email" ? "email" :
            question.type === "tel" ? "tel" : "given-name";
        } else {
          input.rows = 5;
          input.maxLength = 2000;
        }

        input.addEventListener("input", () => {
          answers[question.name] = input.value;
          errorMessage.classList.remove("visible");
        });

        answerArea.appendChild(input);

        if (question.type === "textarea") {
          const help = document.createElement("p");
          help.className = "field-help";
          help.textContent = "Please share a little about your goals.";
          answerArea.appendChild(help);
        }
      }
    }

    function validateCurrentQuestion() {
      const question = questions[currentStep];
      const value = answers[question.name];

      if (typeof value !== "string" || !value.trim()) {
        showError("This question is required. Please provide an answer.");
        return false;
      }

      if (question.type === "email") {
        const emailInput = answerArea.querySelector("input");
        if (!emailInput.checkValidity()) {
          showError("Please enter a valid email address.");
          emailInput.focus();
          return false;
        }
      }

      if (question.type === "tel") {
        const digits = value.replace(/\D/g, "");
        if (digits.length < 7 || digits.length > 15) {
          showError("Please enter a valid phone number.");
          answerArea.querySelector("input").focus();
          return false;
        }
      }

      return true;
    }

    function showError(message) {
      errorMessage.textContent = message;
      errorMessage.classList.add("visible");
    }

    continueButton.addEventListener("click", () => {
      // Capture the latest typed value before validating.
      const question = questions[currentStep];
      const field = answerArea.querySelector(
        'textarea, input:not([type="radio"])'
      );

      if (field) {
        answers[question.name] = field.value;
      }

      if (!validateCurrentQuestion()) return;

      if (currentStep < questions.length - 1) {
        currentStep++;
        renderQuestion();
        window.scrollTo({ top: 0, behavior: "smooth" });
      } else {
        document.getElementById("questionnaire").classList.add("hidden");
        document.getElementById("successScreen").classList.remove("hidden");
      }
    });

    backButton.addEventListener("click", () => {
      const question = questions[currentStep];
      const field = answerArea.querySelector(
        'textarea, input:not([type="radio"])'
      );

      if (field) {
        answers[question.name] = field.value;
      }

      if (currentStep > 0) {
        currentStep--;
        renderQuestion();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });

    renderQuestion();
  </script>
